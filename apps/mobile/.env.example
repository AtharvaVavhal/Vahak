# Copy this file to .env and adjust for your machine.
# Expo inlines EXPO_PUBLIC_* variables at build time - do not put secrets in them.

# Base URL of the NestJS API (services/api). The backend currently exposes
# routes with no global prefix (e.g. POST /auth/login), listening on PORT
# from services/api/.env (default 3000).
#
# - iOS Simulator: http://localhost:3000 works (simulator shares the host's network).
# - Physical device via Expo Go: use your machine's LAN IP, e.g. http://192.168.1.20:3000
# - Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
