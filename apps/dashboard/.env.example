# Copy this file to .env.local and adjust for your machine.
# Next.js only inlines NEXT_PUBLIC_* variables into client bundles - do not put secrets in them.

# Base URL of the NestJS API (services/api). The backend currently exposes routes with
# no global prefix (e.g. POST /auth/login), listening on PORT from services/api/.env
# (default 3000).
NEXT_PUBLIC_API_URL=http://localhost:3000
